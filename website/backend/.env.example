# Erlaubte Website-Domains (kommagetrennt)
ALLOWED_ORIGINS=https://marcel-maximiert.net,https://www.marcel-maximiert.net

# E-Mail-Versand (SMTP deines Mail-Anbieters; Port 465 = SSL, 587 = STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=kontakt@marcel-maximiert.net
SMTP_PASSWORD=
MAIL_FROM=kontakt@marcel-maximiert.net
CONTACT_TO=kontakt@marcel-maximiert.net

# Bestätigungsmail an den Interessenten schicken (true/false)
SEND_CONFIRMATION=true
# Wie viele Tage im Voraus ein Wunschtermin liegen darf
MAX_DAYS=90
